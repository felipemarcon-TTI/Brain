# WooCommerce / WordPress
WC_URL=https://yourstore.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WP_USER=your_wp_username
WP_PASS=your_wp_application_password

# Bling!
BLING_CLIENT_ID=your_bling_client_id
BLING_CLIENT_SECRET=your_bling_client_secret
BLING_REDIRECT_URI=https://seu-app.up.railway.app/bling/callback

# Meta (Instagram/Facebook + Ads)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Os tokens abaixo são preenchidos automaticamente após /meta/auth (persistidos no Railway):
# META_PAGE_TOKEN, META_PAGE_ID, META_IG_ID, META_PAGE_NAME, META_USER_TOKEN, META_AD_ACCOUNT_ID
# Kill-switch de escrita em Ads (pausar/ativar campanha). Default desligado.
ADS_WRITES_ENABLED=false
# Kill-switch de escrita no WooCommerce. Default desligado.
WC_WRITES_ENABLED=false

# Acesso multiusuário (token por pessoa). JSON: [{"id":"...","role":"read|write","token":"..."}]
# MCP_AUTH_TOKEN=token_admin
# MCP_USERS=[]

# Railway (preenchido automaticamente pelo Railway)
# PORT=8000
