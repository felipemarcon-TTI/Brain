# Bling OAuth (obter em: Bling > Configurações > Integrações > API)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Obtido após autenticar via /bling/auth (tela de sucesso mostra o valor)
BLING_REFRESH_TOKEN=

# Token Bearer para autenticar no MCP (gere um valor aleatório seguro)
MCP_AUTH_TOKEN=

# Usuários adicionais com permissão limitada (opcional)
# MCP_USERS=[{"id":"leitura","token":"seu_token","role":"read"}]

# Kill-switch de escrita no Bling. A ExpansaoPet é observe-only: deixe false (default).
# Defina true SÓ com confirmação expressa para liberar atualizar_produto/criar_pedido.
# BLING_WRITES_ENABLED=false

# Meta Ads (SOMENTE LEITURA — eficácia de anúncios + ROAS)
# Crie um App no developers.facebook.com e pegue ID/Secret. Conecte via /meta/auth.
META_APP_ID=
META_APP_SECRET=
# Preenchidos automaticamente após autorizar em /meta/auth (persistidos via Railway API):
# META_USER_TOKEN=
# META_AD_ACCOUNT_ID=
# META_AD_ACCOUNT_NAME=

# Necessárias para persistir tokens (Meta e Bling) entre restarts — já usadas pelo Bling
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=

# Setado automaticamente pelo Railway — não alterar
# PORT=8000
# RAILWAY_PUBLIC_DOMAIN=
