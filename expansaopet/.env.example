# Bling OAuth (obter em: Bling > Configurações > Integrações > API)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Obtido após autenticar via /bling/auth (tela de sucesso mostra o valor)
BLING_REFRESH_TOKEN=

# Token Bearer para autenticar no MCP (gere um valor aleatório seguro)
MCP_AUTH_TOKEN=

# Usuários adicionais com permissão limitada (opcional)
# MCP_USERS=[{"id":"leitura","token":"seu_token","role":"read"}]

# Kill-switch de escrita no Bling. A ExpansaoPet é observe-only: deixe false (default).
# Defina true SÓ com confirmação expressa para liberar atualizar_produto/criar_pedido.
# BLING_WRITES_ENABLED=false

# Meta Ads (SOMENTE LEITURA — eficácia de anúncios + ROAS)
# Crie um App no developers.facebook.com e pegue ID/Secret. Conecte via /meta/auth.
META_APP_ID=
META_APP_SECRET=
# Preenchidos automaticamente após autorizar em /meta/auth (persistidos via Railway API):
# META_USER_TOKEN=
# META_AD_ACCOUNT_ID=
# META_AD_ACCOUNT_NAME=

# Nuvemshop (SOMENTE LEITURA — receita da loja online por canal)
# Crie um app privado em partners.nuvemshop.com.br ("Para os seus clientes"). Conecte via /nuvemshop/auth.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Opcional — User-Agent enviado à API (obrigatório pela Nuvemshop; tem default no código)
# NUVEMSHOP_USER_AGENT=ExpansaoPet Brain (seu-email)
# Preenchidos automaticamente após autorizar em /nuvemshop/auth:
# NUVEMSHOP_ACCESS_TOKEN=
# NUVEMSHOP_STORE_ID=

# GA4 / Google Analytics (SOMENTE LEITURA — tráfego e receita por canal/origem)
# OAuth com a conta que já tem acesso ao GA4 (sem conta de serviço). Crie um "ID do cliente OAuth"
# (tipo Web) no Google Cloud, tela de consentimento "Interno", escopo analytics.readonly.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
# Número da propriedade GA4 (Admin > Config. da propriedade) — NÃO é o G-XXXX
GA4_PROPERTY_ID=
# Preenchido automaticamente após autorizar em /ga4/auth:
# GA4_REFRESH_TOKEN=

# Necessárias para persistir tokens (Meta, Nuvemshop, GA4 e Bling) entre restarts — já usadas pelo Bling
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=

# Setado automaticamente pelo Railway — não alterar
# PORT=8000
# RAILWAY_PUBLIC_DOMAIN=
